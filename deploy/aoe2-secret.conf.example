# EJEMPLO del archivo secreto con la API key de Anthropic.
#
# En el servidor el archivo real es:  /etc/nginx/aoe2-secret.conf
#   - Contiene la API KEY REAL (reemplazar el placeholder de abajo).
#   - chmod 600, owner root:root  -> solo root lo lee, nunca se sirve a la web.
#   - NUNCA se versiona en git (por eso este repo solo tiene el .example).
#
# Crearlo en el server con:
#   echo 'proxy_set_header x-api-key "sk-ant-TU-KEY-REAL";' > /etc/nginx/aoe2-secret.conf
#   chmod 600 /etc/nginx/aoe2-secret.conf
#   chown root:root /etc/nginx/aoe2-secret.conf
#   nginx -t && systemctl reload nginx

proxy_set_header x-api-key "sk-ant-REEMPLAZAR-CON-TU-KEY";
